{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "echo pre <tool>"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "echo hello & welcome"
          }
        ]
      },
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/local/bin/canyon",
            "args": [
              "manifest",
              "--harness",
              "claude-code"
            ]
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "canyon"
          }
        ]
      },
      {
        "matcher": "clear",
        "hooks": [
          {
            "type": "command",
            "command": "canyon manifest --harness claude-code"
          },
          {
            "type": "command",
            "command": "echo mine"
          }
        ]
      }
    ]
  },
  "model": "opus",
  "pad": 1.50,
  "permissions": {
    "allow": [
      "Bash(ls:*)"
    ]
  }
}
