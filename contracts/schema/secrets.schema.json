{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://docs.getcanyon.ai/contracts/schema/secrets.schema.json",
  "title": "Canyon secrets list (seam 3)",
  "description": "The response of GET /api/v1/projects/:id/secrets: the names one project's apps read, and who set each one. contracts/routes.md row 176 is canonical; this schema pins the shape. No route reads a value back, ever, so there is no value here and nothing computed from one — no mask, no length, no digest — and a reader that shows one is showing something it was never handed. The golden under contracts/testdata/secrets/ is the whole list of one project, in the server's own order (env, then name), which is what lets contracts/validate.py check that a client prints it as it comes.",
  "type": "object",
  "additionalProperties": false,
  "required": ["secrets"],
  "properties": {
    "secrets": { "type": "array", "items": { "$ref": "#/definitions/secret" } }
  },
  "definitions": {
    "secret": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "env", "where", "version", "set_by", "set_at", "origin"],
      "properties": {
        "name": { "allOf": [{ "$ref": "#/definitions/envName" }], "maxLength": 128, "not": { "const": "PORT" } },
        "env": { "enum": ["preview", "prod"] },
        "where": { "enum": ["runtime", "build"] },
        "version": { "type": "integer", "minimum": 1 },
        "set_by": { "$ref": "#/definitions/actor" },
        "set_at": { "$ref": "#/definitions/ts" },
        "origin": { "enum": ["user", "gate", "provisioned"] }
      }
    },
    "envName": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
    "ts": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "subject", "display"],
      "properties": {
        "kind": { "enum": ["person", "agent", "canyon"] },
        "subject": { "type": "string", "minLength": 1 },
        "display": { "type": "string" }
      }
    }
  }
}
