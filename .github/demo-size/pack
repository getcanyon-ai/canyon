#!/usr/bin/env bash
# pack, with each line of a verbose build timed when /tmp/probe-verbose is there.
real=/usr/local/bin/pack
if [ "${1:-}" = build ] && [ -f /tmp/probe-verbose ]; then
  set -o pipefail
  "$real" "$@" --verbose 2>&1 | while IFS= read -r l; do printf '%s %s\n' "$(date +%s.%N)" "$l"; done
  exit $?
fi
exec "$real" "$@"
