{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "theme-canyon",
  "type": "registry:theme",
  "title": "Canyon",
  "description": "Canyon's theme: dark slate canonical, teal accent, severity colors as CSS variables. Light mode included.",
  "cssVars": {
    "theme": {
      "font-sans": "'IBM Plex Sans', -apple-system, 'Segoe UI', sans-serif",
      "font-mono": "'IBM Plex Mono', ui-monospace, SFMono-Regular, Menlo, monospace"
    },
    "dark": {
      "background": "#0d1117",
      "card": "#151c24",
      "card-foreground": "#e6edf3",
      "popover": "#151c24",
      "popover-foreground": "#e6edf3",
      "foreground": "#e6edf3",
      "muted": "#10161d",
      "muted-foreground": "#8b98a5",
      "border": "#e6edf314",
      "input": "#e6edf314",
      "primary": "#2dd4bf",
      "primary-foreground": "#0d1117",
      "secondary": "#10161d",
      "secondary-foreground": "#e6edf3",
      "accent": "#151c24",
      "accent-foreground": "#5eead4",
      "destructive": "#f87171",
      "destructive-foreground": "#0d1117",
      "ring": "#2dd4bf",
      "severity-critical": "#f87171",
      "severity-high": "#fb923c",
      "severity-medium": "#fbbf24",
      "severity-low": "#8b98a5",
      "status-pass": "#4ade80"
    },
    "light": {
      "background": "#ffffff",
      "card": "#f4f7fa",
      "card-foreground": "#10161d",
      "popover": "#ffffff",
      "popover-foreground": "#10161d",
      "foreground": "#10161d",
      "muted": "#f4f7fa",
      "muted-foreground": "#5c6873",
      "border": "#10161d14",
      "input": "#10161d14",
      "primary": "#0d9488",
      "primary-foreground": "#ffffff",
      "secondary": "#f4f7fa",
      "secondary-foreground": "#10161d",
      "accent": "#f4f7fa",
      "accent-foreground": "#0f766e",
      "destructive": "#b3261e",
      "destructive-foreground": "#ffffff",
      "ring": "#0d9488",
      "severity-critical": "#b3261e",
      "severity-high": "#a1500a",
      "severity-medium": "#8a6100",
      "severity-low": "#5c6873",
      "status-pass": "#166534"
    }
  }
}
