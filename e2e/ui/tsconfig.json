{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "types": ["node", "@playwright/test"]
  },
  "include": ["harness/*.ts", "journeys/*.ts", "cluster/**/*.ts", "handoff/*.ts", "patch/*.ts","playwright.config.ts"]
}
