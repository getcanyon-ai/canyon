      "check": {
        "by": "ai",
        "facts_version": 3
      }
    },
    {
      "id": "custom.no-lodash",
      "name": "No lodash",
      "state": "blocking",
      "producer": "scanner",
      "instructions": "No app may depend on lodash.",
      "check": {
        "by": "code",
        "expr": "!dependencies.exists(d, d.name == 'lodash')",
        "says": "No dependency is named lodash.",
        "facts_version": 3
      }
    }
