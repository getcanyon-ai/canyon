{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://docs.getcanyon.ai/contracts/schema/patch.schema.json",
  "title": "Canyon's platform patches: a patch run, what it leaves on the reads, its approval and the platform identities",
  "description": "design/PATCHING.md §4. contracts/routes.md (*Patch runs*, *Production approvals*, the patching rows) and contracts/events.md are canonical. Its example is one rebase patch of claims-portal's preview told end to end: the executor's /rebase answer, the run's timeline and read, preview's row and image read after it, the production approval Canyon files, the identities read and the trail.",
  "type": "object", "additionalProperties": false,
  "required": ["rebase", "timeline", "org", "run", "runs", "gate_state", "promote_run", "preview", "image_read", "approval", "identities", "audit", "reverted", "kubernetes", "rule_off", "rebuild"],
  "properties": {
    "rebase": { "$ref": "executor.schema.json#/definitions/rebase_result" },
    "timeline": { "type": "array", "minItems": 1, "items": { "$ref": "timeline-row.schema.json" } },
    "org": { "type": "array", "minItems": 1, "items": { "$ref": "timeline-row.schema.json" } },
    "run": { "$ref": "app-page.schema.json#/definitions/run_read" },
    "runs": { "$ref": "#/definitions/runs" },
    "gate_state": { "$ref": "#/definitions/gate_state" },
    "promote_run": { "type": "string", "pattern": "^gr_[a-z0-9]{4,}$" },
    "preview": { "allOf": [{ "$ref": "app-page.schema.json#/definitions/env" }, { "required": ["patch"] }] },
    "image_read": { "allOf": [{ "$ref": "app-page.schema.json#/definitions/image_read" }, { "required": ["patched"] }] },
    "approval": { "$ref": "#/definitions/approval_read" },
    "identities": { "$ref": "#/definitions/identities_read" },
    "audit": { "$ref": "#/definitions/audit" },
    "reverted": { "$ref": "#/definitions/reverted" },
    "kubernetes": {
      "description": "The same patch's identity and /rebase answer on a Kubernetes host, where run_image is <repository>@sha256:<hex>, any tag stripped: kpack's copy of the run image, as the ClusterBuilder's status.stack.runImage names it by tag and digest and the rebaser records it by digest alone, compared byte for byte (executor.md, POST /rebase).",
      "type": "object", "additionalProperties": false, "required": ["identity", "rebase"],
      "properties": { "identity": { "$ref": "#/definitions/identity" }, "rebase": { "$ref": "executor.schema.json#/definitions/rebase_result" } }
    },
    "rebuild": {
      "description": "A rebuild patch of the same app (routes.md, Patch runs, A rebuild patch; design/PATCHING.md §5): its runtime finding planned under a rebuild identity, its build, the same_inputs proof and its watch on the timeline, its read, the trail it leaves and the patch approval it files, always its team's.",
      "type": "object", "additionalProperties": false, "required": ["identity", "timeline", "run", "audit", "approval"],
      "properties": {
        "identity": { "$ref": "#/definitions/identity" },
        "timeline": { "type": "array", "minItems": 1, "items": { "$ref": "timeline-row.schema.json" } },
        "run": { "$ref": "app-page.schema.json#/definitions/run_read" },
        "audit": { "$ref": "#/definitions/audit" },
        "approval": { "allOf": [{ "$ref": "#/definitions/approval_read" }, { "required": ["rebuild"] }] }
      }
    },
    "rule_off": {
      "description": "The identities read after the next tick, once platform.known-vuln went off on every app (#2588, the review of #2607): its plan read no app, why rule_off, so no cause the tick before gave outlives it.",
      "$ref": "#/definitions/identities_read"
    }
  },
  "definitions": {
    "ts": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" },
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "actor": { "$ref": "app-page.schema.json#/definitions/actor" },
    "runs": {
      "description": "The project's runs, newest first, as the gate-runs list answers them: what gate_state and promote_run are read from (routes.md, Patch runs).",
      "type": "array", "minItems": 1, "items": { "$ref": "app-page.schema.json#/definitions/run" } },
    "gate_state": { "enum": ["never_reviewed", "pending", "running", "clean", "blocked", "failed"] },
    "audit": { "type": "array", "minItems": 1, "items": { "$ref": "app-page.schema.json#/definitions/event" } },
    "reverted": {
      "description": "A patch run of the same app whose patched container restarted in its watch: its timeline, its read, the runs list, the reads it leaves and its trail.",
      "type": "object", "additionalProperties": false,
      "required": ["rebase", "timeline", "run", "runs", "gate_state", "promote_run", "replaced", "preview", "audit"],
      "properties": {
        "rebase": { "$ref": "executor.schema.json#/definitions/rebase_result" },
        "timeline": { "type": "array", "minItems": 1, "items": { "$ref": "timeline-row.schema.json" } },
        "run": { "$ref": "app-page.schema.json#/definitions/run_read" },
        "runs": { "$ref": "#/definitions/runs" },
        "gate_state": { "$ref": "#/definitions/gate_state" },
        "promote_run": { "type": "string", "pattern": "^gr_[a-z0-9]{4,}$" },
        "replaced": { "description": "Preview's row as it was before the patch: what the revert puts back.", "$ref": "app-page.schema.json#/definitions/env" },
        "preview": { "allOf": [{ "$ref": "app-page.schema.json#/definitions/env" }, { "required": ["patch"] }] },
        "audit": { "$ref": "#/definitions/audit" }
      }
    },
    "fix": {
      "description": "One package a patch moved: its name, the version before and after, the vulnerability it fixed and the package's class (finding.md, System libraries and build tools).",
      "type": "object", "additionalProperties": false, "required": ["name", "from", "to", "vulnerability", "class"],
      "properties": { "name": { "type": "string", "minLength": 1, "maxLength": 214 }, "from": { "type": "string", "minLength": 1, "maxLength": 128 },
        "to": { "type": "string", "minLength": 1, "maxLength": 128 }, "vulnerability": { "type": "string", "minLength": 1, "maxLength": 64 },
        "class": { "enum": ["os", "runtime", "lifecycle"] } }
    },
    "patched": {
      "description": "routes.md, the image read's patched[]: what Canyon's patches fixed in the image env runs, found by its digest, newest first, each with the patch run and when that image last reached env.",
      "type": "array", "maxItems": 200,
      "items": { "type": "object", "additionalProperties": false, "required": ["name", "from", "to", "vulnerability", "class", "run", "at"],
        "properties": { "name": { "$ref": "#/definitions/fix/properties/name" }, "from": { "$ref": "#/definitions/fix/properties/from" }, "to": { "$ref": "#/definitions/fix/properties/to" },
          "vulnerability": { "$ref": "#/definitions/fix/properties/vulnerability" }, "class": { "$ref": "#/definitions/fix/properties/class" },
          "run": { "type": "string", "pattern": "^gr_[a-z0-9]{4,}$" }, "at": { "$ref": "#/definitions/ts" } } }
    },
    "env_patch": {
      "description": "routes.md, envs.<env>.patch (design/PATCHING.md §0.3): the environment's patch state, at contributor and above. identity while a plan names one; run the newest patch run of it; approval the open patch approval's code while asked, the denied one's while denied; why exactly while held.",
      "type": "object", "additionalProperties": false, "required": ["state", "since"],
      "allOf": [
        { "if": { "properties": { "state": { "const": "held" } } }, "then": { "required": ["why"] }, "else": { "not": { "required": ["why"] } } },
        { "if": { "properties": { "state": { "enum": ["asked", "denied"] } } }, "then": { "required": ["approval"] }, "else": { "not": { "required": ["approval"] } } },
        { "if": { "properties": { "state": { "enum": ["planned", "patched_preview", "asked", "reverted", "denied"] } } }, "then": { "required": ["identity"] } } ],
      "properties": {
        "state": { "enum": ["none", "planned", "wait", "patched_preview", "asked", "patched", "reverted", "held", "denied", "could_not_rescan"] },
        "since": { "$ref": "#/definitions/ts" },
        "identity": { "$ref": "#/definitions/digest" },
        "run": { "type": "string", "pattern": "^gr_[a-z0-9]{4,}$" },
        "approval": { "type": "string", "pattern": "^[0-9A-HJKMNP-TV-Z]{4}-[0-9A-HJKMNP-TV-Z]{4}$" },
        "why": { "enum": ["blocked", "layers_changed", "config_changed", "not_same_inputs", "patch_regressed", "patch_ineffective", "failed", "production_held", "paused", "preview_ahead"] }
      }
    },
    "approval_read": {
      "description": "GET /api/v1/promotion-approvals/:code of a patch approval (routes.md, Production approvals): the production approval's read, kind patch, filed by Canyon, with the patched image it ships, the fixes, the proof and preview's watch.",
      "type": "object", "additionalProperties": false,
      "required": ["code", "app", "version", "replaces", "requested_by", "requested_via", "requested_at", "expires_at", "state", "approver", "kind", "patch_run", "identity", "replaces_image", "image", "fixes", "proof", "watch"],
      "if": { "required": ["rebuild"] },
      "then": { "properties": { "proof": { "pattern": "^Rebuilt from the same code and the same dependencies with (a newer (Node\\.js|Python|Java|Go)|newer build tools)\\. A rebuild is a new program, not a copy of what production runs, so a person on your team decides\\.$" } } },
      "else": { "properties": { "proof": { "const": "The app's own files are byte for byte the ones in production." } } },
      "properties": {
        "code": { "type": "string", "pattern": "^[0-9A-HJKMNP-TV-Z]{4}-[0-9A-HJKMNP-TV-Z]{4}$" },
        "app": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "version": { "type": "string", "minLength": 1 }, "replaces": { "type": ["string", "null"] },
        "requested_by": { "allOf": [{ "$ref": "#/definitions/actor" }, { "properties": { "kind": { "const": "canyon" }, "subject": { "const": "patch" }, "display": { "const": "Canyon" } } }] },
        "requested_via": { "const": "canyon" },
        "requested_at": { "$ref": "#/definitions/ts" }, "expires_at": { "$ref": "#/definitions/ts" },
        "state": { "enum": ["pending", "approved", "denied", "expired", "outdated"] },
        "decided_by": { "$ref": "#/definitions/actor" }, "decided_at": { "$ref": "#/definitions/ts" },
        "run": { "type": "string", "pattern": "^gr_[a-z0-9]{4,}$" },
        "held": { "type": "object", "additionalProperties": false, "required": ["by", "at", "reason"],
          "properties": { "by": { "$ref": "#/definitions/actor" }, "at": { "$ref": "#/definitions/ts" }, "reason": { "type": "string", "minLength": 1, "maxLength": 1024 } } },
        "replaces_image": { "$ref": "#/definitions/digest" },
        "image": { "$ref": "#/definitions/digest" },
        "receipt": { "type": "object" }, "answered": { "type": "object" },
        "approver": { "type": "object", "additionalProperties": false, "required": ["display", "email"], "properties": { "display": { "type": "string" }, "email": { "type": "string" } } },
        "kind": { "const": "patch" },
        "patch_run": { "type": "string", "pattern": "^gr_[a-z0-9]{4,}$" },
        "identity": { "$ref": "#/definitions/digest" },
        "fixes": { "type": "array", "minItems": 1, "maxItems": 200, "items": { "$ref": "#/definitions/fix" } },
        "rebuild": { "const": true },
        "proof": { "type": "string" },
        "watch": { "type": "object", "additionalProperties": false, "required": ["until", "result"],
          "properties": { "until": { "$ref": "#/definitions/ts" }, "result": { "const": "passed" } } }
      }
    },
    "identity": {
      "description": "One platform identity (design/PATCHING.md §4.2, §5): kind rebase, one target run image digest, or kind rebuild, one builder digest, rolled out in waves 0 (the canary) to 3 (the rest). paused while its breaker tripped and no admin resumed it; approved once an admin approved it for production across the fleet, which a rebuild identity never is.",
      "type": "object", "additionalProperties": false, "required": ["id", "kind", "run_image", "planned_at", "wave", "apps"],
      "if": { "properties": { "kind": { "const": "rebuild" } } },
      "then": { "required": ["builder"], "not": { "required": ["approved"] } },
      "else": { "not": { "required": ["builder"] } },
      "properties": {
        "id": { "$ref": "#/definitions/digest" },
        "kind": { "enum": ["rebase", "rebuild"] },
        "builder": { "type": "string", "minLength": 1, "maxLength": 512 },
        "run_image": { "type": "string", "minLength": 1, "maxLength": 512 },
        "planned_at": { "$ref": "#/definitions/ts" },
        "wave": { "type": "integer", "minimum": 0, "maximum": 3 },
        "apps": { "type": "object", "additionalProperties": false, "required": ["planned", "patched_preview", "asked", "patched", "reverted", "held", "denied"],
          "properties": { "planned": { "type": "integer", "minimum": 0 }, "patched_preview": { "type": "integer", "minimum": 0 }, "asked": { "type": "integer", "minimum": 0 },
            "patched": { "type": "integer", "minimum": 0 }, "reverted": { "type": "integer", "minimum": 0 }, "held": { "type": "integer", "minimum": 0 },
            "denied": { "type": "integer", "minimum": 0 } } },
        "paused": { "type": "object", "additionalProperties": false, "required": ["at", "projects"],
          "properties": { "at": { "$ref": "#/definitions/ts" }, "projects": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" } } } },
        "stalled": { "type": "object", "additionalProperties": false, "required": ["at", "projects"],
          "properties": { "at": { "$ref": "#/definitions/ts" }, "projects": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" } } } },
        "approved": { "type": "object", "additionalProperties": false, "required": ["by", "at", "reason"],
          "properties": { "by": { "$ref": "#/definitions/actor" }, "at": { "$ref": "#/definitions/ts" }, "reason": { "type": "string", "minLength": 1, "maxLength": 1024 } } }
      }
    },
    "identities_read": {
      "type": "object", "additionalProperties": false, "required": ["identities", "run_image", "plan"],
      "properties": { "identities": { "type": "array", "items": { "$ref": "#/definitions/identity" } },
        "run_image": {
          "description": "routes.md, the identities row: the run image Canyon names now, as the newest rescan tick read it from GET /builder, how many apps have an environment that reads wait, and their ids, sorted; null when Canyon can't tell, never read as nothing behind.",
          "oneOf": [{ "type": "null" }, { "type": "object", "additionalProperties": false, "required": ["image", "behind", "projects"],
            "properties": { "image": { "type": "string", "minLength": 1, "maxLength": 512 }, "behind": { "type": "integer", "minimum": 0 },
              "projects": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" } } } }] },
        "plan": {
          "description": "routes.md, the identities row's plan (#2588): what the newest rescan tick's patch plan said, null until a tick has planned. why only when it read no app, and then no app; else each app it read, sorted by project, with the one cause its server log line gives it, unknown for one the plan does not name. identity the identity it planned onto, null when it named none.",
          "oneOf": [{ "type": "null" }, { "type": "object", "additionalProperties": false, "required": ["at", "identity", "apps"],
            "properties": { "at": { "$ref": "#/definitions/ts" },
              "identity": { "oneOf": [{ "type": "null" }, { "$ref": "#/definitions/digest" }] },
              "why": { "enum": ["server_off", "org_off", "not_wired", "no_preview", "rule_off", "failed"] },
              "apps": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["project", "why"],
                "properties": { "project": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
                  "why": { "enum": ["started", "refused", "no_digest", "policy", "rule_off", "unread", "no_finding", "no_fix", "runtime",
                    "run_image_unread", "stopped", "under_way", "passed", "ended_early", "reverted", "failed_start", "failed", "paused", "wave",
                    "stalled", "goes_first", "offline", "moved", "unknown"] } } } } } }] } }
    }
  }
}
