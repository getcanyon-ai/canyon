{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://docs.getcanyon.ai/contracts/schema/integrations.schema.json",
  "title": "Canyon chat channels (seam 3)",
  "description": "The org's chat channels and the message Canyon posts to them (contracts/routes.md, the channels row and *Integrations*; design/INTEGRATIONS.md; #2725). No read answers a channel's webhook URL: it is a bearer credential, sealed in the vault, and a channel names only its host and last four characters. The golden under contracts/testdata/integrations/ holds a list, a PUT, a summary and the messages a tick posts.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "list",
    "put",
    "summary",
    "messages"
  ],
  "properties": {
    "list": {
      "$ref": "#/definitions/list"
    },
    "put": {
      "$ref": "#/definitions/put"
    },
    "summary": {
      "$ref": "#/definitions/summary"
    },
    "messages": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/message"
      }
    }
  },
  "definitions": {
    "ts": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "subject",
        "display"
      ],
      "properties": {
        "kind": {
          "enum": [
            "person",
            "agent",
            "canyon"
          ]
        },
        "subject": {
          "type": "string",
          "minLength": 1
        },
        "display": {
          "type": "string"
        }
      }
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,39}$"
    },
    "kind": {
      "enum": [
        "slack",
        "teams"
      ]
    },
    "channel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "kind",
        "host",
        "tail",
        "set_by",
        "set_at",
        "failing"
      ],
      "properties": {
        "id": {
          "$ref": "#/definitions/id"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "kind": {
          "$ref": "#/definitions/kind"
        },
        "host": {
          "type": "string",
          "minLength": 1,
          "maxLength": 253
        },
        "tail": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4
        },
        "set_by": {
          "$ref": "#/definitions/actor"
        },
        "set_at": {
          "$ref": "#/definitions/ts"
        },
        "failing": {
          "description": "null, or since when Slack or Teams has answered this channel's webhook 404 or 410, and which: nothing more posts to it until an admin saves it again.",
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "since",
                "status"
              ],
              "properties": {
                "since": {
                  "$ref": "#/definitions/ts"
                },
                "status": {
                  "enum": [
                    404,
                    410
                  ]
                }
              }
            }
          ]
        }
      }
    },
    "list": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "channels"
      ],
      "properties": {
        "channels": {
          "type": "array",
          "maxItems": 5,
          "items": {
            "$ref": "#/definitions/channel"
          }
        }
      }
    },
    "put": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "kind"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "kind": {
          "$ref": "#/definitions/kind"
        },
        "url": {
          "type": "string",
          "pattern": "^https://",
          "maxLength": 2048
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "needs",
        "apps",
        "more",
        "link"
      ],
      "properties": {
        "kind": {
          "const": "summary"
        },
        "needs": {
          "type": "integer",
          "minimum": 0
        },
        "apps": {
          "type": "array",
          "maxItems": 5,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "more": {
          "type": "integer",
          "minimum": 0
        },
        "link": {
          "type": "string",
          "pattern": "^https?://.+/#/fleet$"
        }
      }
    },
    "message": {
      "description": "One message a tick posts (contracts/routes.md, *Integrations*): a need opening or clearing, or how many more past a minute's twenty. Names only: fields carries at most these five, never another field the need adds.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "link"
      ],
      "properties": {
        "kind": {
          "enum": [
            "need",
            "overflow"
          ]
        },
        "need": {
          "enum": [
            "held",
            "down",
            "refused",
            "refused_code",
            "secret",
            "approval",
            "patch",
            "notify_failing"
          ]
        },
        "state": {
          "enum": [
            "open",
            "cleared"
          ]
        },
        "app": {
          "type": "string",
          "minLength": 1
        },
        "env": {
          "const": "prod"
        },
        "fields": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "destination": {
              "type": "string",
              "minLength": 1,
              "maxLength": 253
            },
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "version": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "state": {
              "enum": [
                "stopped",
                "restarting"
              ]
            },
            "channel": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            }
          }
        },
        "since": {
          "$ref": "#/definitions/ts"
        },
        "more": {
          "type": "integer",
          "minimum": 2
        },
        "link": {
          "type": "string",
          "pattern": "^https?://.+/#/(fleet|settings/integrations|apps/[a-z0-9-]+(/outbound)?)$"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "need"
              }
            }
          },
          "then": {
            "required": [
              "need",
              "state",
              "fields"
            ],
            "not": {
              "required": [
                "more"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "overflow"
              }
            }
          },
          "then": {
            "required": [
              "more"
            ],
            "properties": {
              "link": {
                "pattern": "/#/fleet$"
              }
            },
            "not": {
              "anyOf": [
                {
                  "required": [
                    "need"
                  ]
                },
                {
                  "required": [
                    "app"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "need": {
                "const": "notify_failing"
              }
            },
            "required": [
              "need"
            ]
          },
          "then": {
            "not": {
              "required": [
                "app"
              ]
            },
            "properties": {
              "link": {
                "pattern": "/#/settings/integrations$"
              }
            }
          },
          "else": {
            "if": {
              "required": [
                "need"
              ]
            },
            "then": {
              "required": [
                "app"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "cleared"
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "not": {
              "required": [
                "since"
              ]
            }
          }
        }
      ]
    }
  }
}
