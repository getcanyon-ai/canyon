{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://docs.getcanyon.ai/contracts/schema/access.schema.json",
  "title": "Canyon app access (seam 3)",
  "description": "The Access group of contracts/routes.md, which is canonical for the routes; the permissions design wins on the model. One app's access read, one share with the read it answers, the four audit rows the group writes, and the three refusals App teams and the group answer. The fixture under contracts/testdata/access/ is one app read by its owner.",
  "definitions": {
    "ts": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" },
    "email": { "type": "string", "maxLength": 254, "pattern": "^[^\\x00-\\x1F\\x7F@A-Z]+@[^\\x00-\\x1F\\x7F@A-Z]+$" },
    "group": { "type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[^\\x00-\\x1F\\x7F]+$" },
    "level": { "enum": ["owner", "contributor", "viewer"] },
    "roles": { "type": "array", "uniqueItems": true, "maxItems": 16, "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,39}$" } },
    "actor": {
      "type": "object", "additionalProperties": false, "required": ["kind", "subject", "display"],
      "properties": { "kind": { "enum": ["person", "agent", "canyon"] }, "subject": { "type": "string", "minLength": 1 }, "display": { "type": "string" } }
    },
    "grant": { "type": "object", "allOf": [{ "$ref": "#/definitions/target" }], "additionalProperties": false, "properties": { "kind": {}, "grantee": {} } },
    "target": {
      "description": "Who a grant names: a lower-cased address, a group name, or everyone (the path's :grantee is the word everyone; the row stores an empty grantee).",
      "type": "object", "required": ["kind", "grantee"],
      "properties": { "kind": { "enum": ["email", "group", "everyone"] }, "grantee": { "type": "string" } },
      "allOf": [
        { "if": { "properties": { "kind": { "const": "email" } } }, "then": { "properties": { "grantee": { "$ref": "#/definitions/email" } } } },
        { "if": { "properties": { "kind": { "const": "group" } } }, "then": { "properties": { "grantee": { "$ref": "#/definitions/group" } } } },
        { "if": { "properties": { "kind": { "const": "everyone" } } }, "then": { "properties": { "grantee": { "const": "everyone" } } } }
      ]
    },
    "entry": {
      "type": "object", "additionalProperties": false, "required": ["kind", "grantee", "display", "level", "roles", "granted_by", "granted_at"],
      "properties": {
        "kind": { "enum": ["email", "group"] }, "grantee": { "type": "string", "minLength": 1 }, "display": { "type": "string", "minLength": 1 },
        "level": { "$ref": "#/definitions/level" }, "roles": { "$ref": "#/definitions/roles" },
        "granted_by": { "$ref": "#/definitions/actor" }, "granted_at": { "$ref": "#/definitions/ts" }
      }
    },
    "read": {
      "type": "object", "additionalProperties": false, "required": ["everyone", "entries", "roles", "requests"],
      "properties": {
        "everyone": { "anyOf": [{ "type": "null" }, { "type": "object", "additionalProperties": false, "required": ["roles"], "properties": { "roles": { "$ref": "#/definitions/roles" } } }] },
        "entries": { "type": "array", "items": { "$ref": "#/definitions/entry" } },
        "roles": {
          "type": "array", "maxItems": 16,
          "items": { "type": "object", "additionalProperties": false, "required": ["name", "description"], "properties": { "name": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,39}$" }, "description": { "type": "string", "maxLength": 120 } } }
        },
        "requests": {
          "type": "array",
          "items": { "type": "object", "additionalProperties": false, "required": ["email", "display", "requested_at", "level"], "properties": { "email": { "$ref": "#/definitions/email" }, "display": { "type": "string" }, "requested_at": { "$ref": "#/definitions/ts" }, "level": { "description": "Added 2026-11-09 (#2774): the asker's level when they asked, none or viewer; null on a request from before it was recorded.", "enum": ["none", "viewer", null] } } }
        }
      }
    },
    "change": {
      "type": "object", "additionalProperties": false, "required": ["before", "after"],
      "properties": { "before": {}, "after": {} }
    },
    "event": {
      "type": "object", "additionalProperties": false, "required": ["id", "ts", "actor", "action", "category", "project", "detail"],
      "properties": {
        "id": { "type": "string", "pattern": "^ev_[a-f0-9]{4,}$" }, "ts": { "$ref": "#/definitions/ts" }, "actor": { "$ref": "#/definitions/actor" },
        "action": { "enum": ["share app", "unshare app", "request access", "dismiss access request"] },
        "category": { "const": "governance" },
        "via": { "enum": ["dashboard", "cli", "mcp", "github", "platform", "canyon"] }, "role": { "enum": ["admin", "responder", "member"] }, "session": { "type": "string", "pattern": "^ses_[0-9a-f]{16}$" }, "source": { "type": "string", "minLength": 1, "maxLength": 64 },
        "project": { "type": "string", "pattern": "^[a-z]([a-z0-9-]*[a-z0-9])?$", "maxLength": 55 },
        "detail": { "type": "object" }
      },
      "allOf": [
        { "if": { "properties": { "action": { "const": "share app" } } }, "then": { "properties": { "detail": {
          "allOf": [{ "$ref": "#/definitions/target" }], "additionalProperties": false, "required": ["kind", "grantee", "level", "roles"],
          "properties": {
            "kind": {}, "grantee": {},
            "level": { "allOf": [{ "$ref": "#/definitions/change" }], "properties": { "before": { "anyOf": [{ "type": "null" }, { "$ref": "#/definitions/level" }] }, "after": { "$ref": "#/definitions/level" } } },
            "roles": { "allOf": [{ "$ref": "#/definitions/change" }], "properties": { "before": { "anyOf": [{ "type": "null" }, { "$ref": "#/definitions/roles" }] }, "after": { "$ref": "#/definitions/roles" } } }
          },
          "if": { "properties": { "kind": { "const": "everyone" } } }, "then": { "properties": { "level": { "properties": { "after": { "const": "viewer" } } } } } } } } },
        { "if": { "properties": { "action": { "const": "unshare app" } } }, "then": { "properties": { "detail": {
          "allOf": [{ "$ref": "#/definitions/target" }], "additionalProperties": false, "required": ["kind", "grantee", "level", "roles"],
          "properties": { "kind": {}, "grantee": {}, "level": { "$ref": "#/definitions/level" }, "roles": { "$ref": "#/definitions/roles" } } } } } },
        { "if": { "properties": { "action": { "enum": ["request access", "dismiss access request"] } } }, "then": { "properties": { "detail": {
          "type": "object", "additionalProperties": false, "required": ["email"], "properties": { "email": { "$ref": "#/definitions/email" } } } } } }
      ]
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": ["project", "read", "share", "audit", "team_required", "owner_required", "groups_unsupported", "last_owner"],
  "properties": {
    "project": { "type": "string", "pattern": "^[a-z]([a-z0-9-]*[a-z0-9])?$", "maxLength": 55 },
    "read": { "$ref": "#/definitions/read" },
    "share": {
      "description": "PUT /api/v1/projects/:id/access/:kind/:grantee: the path's grant, the body, and the read it answers. everyone is granted read-only, never more.",
      "type": "object", "additionalProperties": false, "required": ["grant", "request", "response"],
      "properties": {
        "grant": { "$ref": "#/definitions/grant" },
        "request": { "type": "object", "additionalProperties": false, "required": ["level"], "properties": { "level": { "$ref": "#/definitions/level" }, "roles": { "$ref": "#/definitions/roles" } } },
        "response": { "$ref": "#/definitions/read" }
      },
      "if": { "properties": { "grant": { "properties": { "kind": { "const": "everyone" } } } } },
      "then": { "properties": { "request": { "properties": { "level": { "const": "viewer" } } } } }
    },
    "audit": { "type": "array", "minItems": 4, "items": { "$ref": "#/definitions/event" } },
    "team_required": {
      "type": "object", "additionalProperties": false, "required": ["error", "message", "owners", "owner_groups"],
      "properties": {
        "error": { "const": "team_required" }, "message": { "type": "string", "pattern": "^Ask .+ to add you to [a-z]([a-z0-9-]*[a-z0-9])?'s team: on its page in Canyon, use (Ask to join its team|Ask for access)\\.$" },
        "owners": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["kind", "subject", "display"], "properties": { "kind": { "const": "person" }, "subject": { "type": "string" }, "display": { "type": "string", "minLength": 1 } } } },
        "owner_groups": { "description": "The groups holding a grant at owner, by name, sorted (routes.md, App teams): whom to ask when no person owns the app.", "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "owner_required": {
      "type": "object", "additionalProperties": false, "required": ["error", "message"],
      "properties": { "error": { "const": "owner_required" }, "message": { "type": "string", "pattern": "^only the owners of [a-z]([a-z0-9-]*[a-z0-9])? and admins can do this: ask .+$" } }
    },
    "last_owner": {
      "type": "object", "additionalProperties": false, "required": ["error", "message"],
      "properties": { "error": { "const": "last_owner" }, "message": { "const": "add a successor first" } }
    },
    "groups_unsupported": {
      "type": "object", "additionalProperties": false, "required": ["error", "message"],
      "properties": { "error": { "const": "groups_unsupported" }, "message": { "const": "This Canyon doesn't read groups from your sign-in yet. An admin sets the groups claim in Settings." } }
    }
  }
}
