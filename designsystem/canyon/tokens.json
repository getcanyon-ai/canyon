{
  "$description": "Canyon's design tokens (W3C DTCG, hex-string draft). Canonical look: dark slate, teal accent, the four finding severities as first-class colors. Palette source: the dashboard's original mock.",
  "color": {
    "$type": "color",
    "ink": {
      "$description": "Canyon's slate scale — backgrounds, surfaces, text.",
      "950": { "$value": "#0d1117" },
      "900": { "$value": "#10161d" },
      "850": { "$value": "#151c24" },
      "700": { "$value": "#5c6873" },
      "500": { "$value": "#8b98a5" },
      "100": { "$value": "#e6edf3" },
      "50": { "$value": "#f4f7fa" },
      "white": { "$value": "#ffffff" }
    },
    "teal": {
      "$description": "The accent.",
      "300": { "$value": "#5eead4" },
      "400": { "$value": "#2dd4bf" },
      "600": { "$value": "#0d9488" },
      "700": { "$value": "#0f766e" }
    },
    "border": {
      "$description": "Hairline borders — ink at 8% alpha, per the prototype's --border.",
      "dark": { "$value": "#e6edf314" },
      "light": { "$value": "#10161d14" }
    },
    "severity": {
      "$description": "Finding severities per the findings contract (critical | high | medium | low). Base values read on dark; -deep variants read on light.",
      "critical": { "$value": "#f87171" },
      "critical-deep": { "$value": "#b3261e" },
      "high": { "$value": "#fb923c" },
      "high-deep": { "$value": "#a1500a" },
      "medium": { "$value": "#fbbf24" },
      "medium-deep": { "$value": "#8a6100" },
      "low": { "$value": "#8b98a5" },
      "low-deep": { "$value": "#5c6873" }
    },
    "status": {
      "pass": { "$value": "#4ade80" },
      "pass-deep": { "$value": "#166534" }
    }
  },
  "font": {
    "$type": "fontFamily",
    "sans": { "$value": ["IBM Plex Sans", "-apple-system", "Segoe UI", "sans-serif"] },
    "mono": { "$value": ["IBM Plex Mono", "ui-monospace", "SFMono-Regular", "Menlo", "monospace"] }
  }
}
