{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://docs.getcanyon.ai/contracts/schema/guardrails.schema.json",
  "title": "Canyon org preferences and agentic setup (seam 3)",
  "description": "The ten shapes the guardrails screen reads and writes: the preferences read, the manifest an agent is handed, and the same for one app, the design-system registry rows, one setup turn that wrote something, one setup turn that proposed a policy change and wrote nothing, the 404 a host with no model answers, and the component-types menu GET /api/v1/component-types answers. contracts/routes.md is canonical; this schema pins the shapes. Every value is typed data — a panel renders it, and the model writes no prose into any field — the two exceptions are a component type's `notes`, agent-read product copy the host authors, never the model, and the manifest's `how` and `instructions` on a rule that blocks alone: Canyon's own line on how to pass a Canyon rule, and a custom rule's text as an admin wrote it.",
  "definitions": {
    "says": { "type": "string", "minLength": 1, "maxLength": 280, "pattern": "^[^\\x00-\\x1F\\x7F-\\x9F]+$", "description": "A custom rule's code check in plain words (snapshot.md, Custom rules), handed beside its instructions (routes.md, GET /skill/manifest)." },
    "instructions": { "type": "string", "minLength": 1, "maxLength": 2000, "pattern": "^[^\\x00-\\x09\\x0B-\\x1F\\x7F-\\x9F]+$", "description": "A custom rule's text as its admin wrote it (snapshot.md, Custom rules), handed to an agent where the rule blocks (routes.md, GET /skill/manifest)." },
    "how": { "type": "string", "minLength": 1, "maxLength": 120, "pattern": "^[^\\x00-\\x1F\\x7F-\\x9F]+$", "description": "Canyon's own line on how to pass a Canyon rule (gate/policy's howToPass), handed to an agent where the rule blocks (routes.md, GET /skill/manifest)." },
    "blocks": { "anyOf": [ { "required": ["state"], "properties": { "state": { "const": "blocking" } } }, { "required": ["production"], "properties": { "production": { "const": "blocking" } } } ] },
    "blocksCustom": { "allOf": [ { "properties": { "id": { "pattern": "^custom\\." } } }, { "$ref": "#/definitions/blocks" } ] },
    "blocksCanyon": { "allOf": [ { "properties": { "id": { "not": { "pattern": "^custom\\." } } } }, { "$ref": "#/definitions/blocks" } ] },
    "dsId": { "type": "string", "pattern": "^ds_[a-z0-9]{4,}$" },
    "name": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[^\\x00-\\x1F\\x7F]+$" },
    "namespace": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[^\\x00-\\x1F\\x7F]+$" },
    "url": { "type": "string", "maxLength": 2048, "pattern": "^(https://[^@/?#\\s]+|http://(localhost|127\\.0\\.0\\.1|\\[::1\\])(:[0-9]+)?)(/[^\\s]*)?$" },
    "ts": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" },
    "orgName": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[^\\x00-\\x1F\\x7F]+$" },
    "domain": { "type": "string", "minLength": 1, "maxLength": 253, "pattern": "^[^\\x00-\\x1F\\x7F]+$" },
    "email": { "type": "string", "minLength": 1, "maxLength": 254, "pattern": "^[^\\x00-\\x1F\\x7F]+$" },
    "claim": { "type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[^\\x00-\\x1F\\x7F]+$" },
    "domains": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/definitions/domain" } },
    "emails": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/definitions/email" } },
    "overridable": { "enum": ["org_name", "allowed_domains", "allowed_emails", "admin_claim", "admin_value", "responder_claim", "responder_value", "groups_claim"] },
    "runBy": { "description": "Where apps run (the hand-off design §1): Canyon's router on this cluster, or the org's own platform through releases.", "enum": ["canyon", "org"] },
    "delivery": { "description": "How releases reach the org's platform under run_by org (the hand-off design §1, §3b): a signed webhook, or a commit to the deploy repo.", "enum": ["webhook", "repo"] },
    "accessGrace": { "description": "How long a handed-off app keeps serving its last access list when Canyon is unreachable, as Go spells a duration, 0 to 24h; the range is the server's to refuse.", "type": "string", "minLength": 1, "pattern": "^(0|([0-9]+h)?([0-9]+m)?([0-9]+s)?)$" },
    "groupsClaim": { "description": "The sign-in claim carrying a person's groups; empty while unset, when no group grant is written (routes.md, the Access group).", "type": "string", "maxLength": 256, "pattern": "^[^\\x00-\\x1F\\x7F]*$" },
    "viewer": {
      "description": "Who is reading, as GET /api/v1/preferences answers it (routes.md row 219): the address the session stores and the role, so the settings page can find the reader in the lists it draws. GET /api/v1/fleet answers the same concept as {display, role} — one name, two projections, no consumer gets both.",
      "type": "object", "additionalProperties": false, "required": ["email", "role"],
      "properties": { "email": { "$ref": "#/definitions/email" }, "role": { "enum": ["member", "responder", "admin"] } }
    },
    "stacks": {
      "type": "array", "maxItems": 16,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["language", "frameworks"],
        "properties": {
          "language": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[^\\x00-\\x1F\\x7F]+$" },
          "frameworks": { "type": "array", "minItems": 1, "maxItems": 16, "items": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[^\\x00-\\x1F\\x7F]+$" } }
        }
      }
    },
    "buildpackId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9./-]{0,127}$" },
    "approvedBuildpacks": { "type": "array", "maxItems": 64, "uniqueItems": true, "items": { "$ref": "#/definitions/buildpackId" } },
    "resolved": {
      "type": ["object", "null"], "additionalProperties": false, "required": ["id", "name", "namespace", "registry_url"],
      "properties": {
        "id": { "$ref": "#/definitions/dsId" }, "name": { "$ref": "#/definitions/name" }, "namespace": { "$ref": "#/definitions/namespace" },
        "registry_url": { "$ref": "#/definitions/url" }, "tokens_url": { "$ref": "#/definitions/url" }
      }
    },
    "row": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "name", "namespace", "source_type", "registry_url", "created_at", "created_by"],
      "properties": {
        "id": { "$ref": "#/definitions/dsId" }, "name": { "$ref": "#/definitions/name" }, "namespace": { "$ref": "#/definitions/namespace" },
        "source_type": { "enum": ["shipped", "registry"] }, "registry_url": { "$ref": "#/definitions/url" }, "tokens_url": { "$ref": "#/definitions/url" },
        "created_at": { "$ref": "#/definitions/ts" }, "created_by": { "type": "string", "minLength": 1 }
      }
    },
    "componentType": {
      "type": "object", "additionalProperties": false, "required": ["type", "class", "gives", "status", "notes"],
      "properties": {
        "type": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "class": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "gives": { "type": "array", "minItems": 1, "items": { "type": "string", "maxLength": 128, "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" } },
        "status": { "enum": ["available", "planned"] },
        "notes": { "type": "string", "minLength": 1 }
      }
    },
    "write": {
      "type": "object", "additionalProperties": false, "required": ["tool", "before", "after"],
      "properties": {
        "tool": { "enum": ["set_stacks", "set_design_system"] },
        "before": { "type": ["array", "object", "null"] },
        "after": { "type": ["array", "object", "null"] }
      }
    },
    "proposal": {
      "type": "object", "additionalProperties": false, "required": ["rule", "state", "would_block"],
      "properties": {
        "rule": { "type": "string", "pattern": "^[a-z]+\\.[a-z][a-z-]*$" },
        "state": { "enum": ["off", "advisory", "blocking"] },
        "grace_days": { "type": "integer", "minimum": 1 },
        "would_block": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false, "required": ["project", "findings"],
            "properties": { "project": { "type": "string", "pattern": "^[a-z]([a-z0-9-]*[a-z0-9])?$", "maxLength": 55 }, "findings": { "type": "integer", "minimum": 1 } }
          }
        }
      }
    },
    "preferencesPut": {
      "type": "object", "additionalProperties": false, "minProperties": 1,
      "dependencies": { "admin_claim": ["admin_value"], "admin_value": ["admin_claim"], "responder_claim": ["responder_value"], "responder_value": ["responder_claim"] },
      "properties": {
        "stacks": { "$ref": "#/definitions/stacks" }, "approved_buildpacks": { "$ref": "#/definitions/approvedBuildpacks" },
        "design_system_id": { "anyOf": [ { "$ref": "#/definitions/dsId" }, { "type": "null" } ] },
        "org_name": { "$ref": "#/definitions/orgName" },
        "allowed_domains": { "$ref": "#/definitions/domains" }, "allowed_emails": { "$ref": "#/definitions/emails" }, "admin_emails": { "$ref": "#/definitions/emails" },
        "admin_claim": { "anyOf": [ { "$ref": "#/definitions/claim" }, { "type": "null" } ] }, "admin_value": { "anyOf": [ { "$ref": "#/definitions/claim" }, { "type": "null" } ] },
        "responder_emails": { "$ref": "#/definitions/emails" },
        "responder_claim": { "anyOf": [ { "$ref": "#/definitions/claim" }, { "type": "null" } ] }, "responder_value": { "anyOf": [ { "$ref": "#/definitions/claim" }, { "type": "null" } ] },
        "groups_claim": { "$ref": "#/definitions/groupsClaim" },
        "onboarded_at": { "$ref": "#/definitions/ts" },
        "run_by": { "$ref": "#/definitions/runBy" }, "access_grace": { "$ref": "#/definitions/accessGrace" }, "delivery": { "$ref": "#/definitions/delivery" },
        "prod_approval": { "type": "boolean" },
        "push_approvers_linked": { "type": "boolean" },
        "patching": { "enum": ["off", "ask"] },
        "rebuilds": { "enum": ["off", "ask"] },
        "db_prod": { "enum": ["off", "read", "write"] }, "db_sessions": { "enum": ["off", "on"] }
      }
    },
    "designSystemCreate": {
      "type": "object", "additionalProperties": false, "required": ["name", "namespace", "registry_url"],
      "properties": { "name": { "$ref": "#/definitions/name" }, "namespace": { "$ref": "#/definitions/namespace" }, "registry_url": { "$ref": "#/definitions/url" }, "tokens_url": { "$ref": "#/definitions/url" } }
    },
    "turn": {
      "type": "object", "additionalProperties": false, "required": ["request", "response"],
      "properties": {
        "request": {
          "type": "object", "additionalProperties": false, "required": ["messages"],
          "properties": {
            "messages": {
              "type": "array", "minItems": 1, "maxItems": 20,
              "items": {
                "type": "object", "additionalProperties": false, "required": ["role", "content"],
                "properties": { "role": { "enum": ["user", "assistant"] }, "content": { "type": "string", "minLength": 1, "maxLength": 8192 } }
              }
            }
          }
        },
        "response": {
          "type": "object", "additionalProperties": false, "required": ["message", "writes"],
          "properties": {
            "message": { "type": "string", "minLength": 1 },
            "writes": { "type": "array", "maxItems": 8, "items": { "$ref": "#/definitions/write" } },
            "proposal": { "$ref": "#/definitions/proposal" }
          }
        }
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": ["preferences", "preferences_admin", "preferences_member", "preferences_put", "manifest", "manifest_app", "design_systems", "design_system_create", "setup", "proposal", "setup_unavailable", "component_types"],
  "properties": {
    "preferences": {
      "description": "The read as the server answers it TODAY. cmd/canyon-server's TestThePreferencesAreTheGoldenShape compares its response to this object byte for byte, and to preferences_put.response, so a key added here before the server answers it turns main red. The widened read of routes.md row 219 lives in preferences_admin and preferences_member; this one moves when the server moves, in the PR that implements it.",
      "type": "object", "additionalProperties": false,
      "required": ["stacks", "approved_buildpacks", "buildpacks_seen", "design_system", "setup_available", "ai_review", "org_name", "allowed_domains", "allowed_emails", "admin_emails", "onboarded_at", "prod_approval", "push_approvers_linked", "overridden"],
      "dependencies": { "admin_claim": ["admin_value"], "admin_value": ["admin_claim"], "responder_claim": ["responder_value"], "responder_value": ["responder_claim"] },
      "properties": {
        "stacks": { "$ref": "#/definitions/stacks" }, "design_system": { "$ref": "#/definitions/resolved" }, "setup_available": { "type": "boolean" }, "ai_review": { "type": "boolean" },
        "approved_buildpacks": { "$ref": "#/definitions/approvedBuildpacks" },
        "buildpacks_seen": { "type": "array", "maxItems": 256, "items": { "type": "object", "additionalProperties": false, "required": ["id"],
          "properties": { "id": { "$ref": "#/definitions/buildpackId" }, "name": { "type": "string", "pattern": "^[A-Za-z0-9][ -~]{0,127}$" } } } },
        "viewer": { "$ref": "#/definitions/viewer" },
        "org_name": { "$ref": "#/definitions/orgName" },
        "allowed_domains": { "$ref": "#/definitions/domains" }, "allowed_emails": { "$ref": "#/definitions/emails" }, "admin_emails": { "$ref": "#/definitions/emails" },
        "bootstrap_admins": { "$ref": "#/definitions/emails" },
        "admin_claim": { "$ref": "#/definitions/claim" }, "admin_value": { "$ref": "#/definitions/claim" },
        "responder_emails": { "description": "The security responders by address (routes.md row 219; the permissions design, Security responders): answered to an admin only, as is the responder claim and its value.", "$ref": "#/definitions/emails" },
        "responder_claim": { "$ref": "#/definitions/claim" }, "responder_value": { "$ref": "#/definitions/claim" },
        "groups_claim": { "$ref": "#/definitions/groupsClaim" },
        "onboarded_at": { "anyOf": [ { "$ref": "#/definitions/ts" }, { "type": "null" } ] },
        "run_by": { "$ref": "#/definitions/runBy" }, "access_grace": { "$ref": "#/definitions/accessGrace" }, "delivery": { "$ref": "#/definitions/delivery" },
        "prod_approval": { "type": "boolean" },
        "push_approvers_linked": { "type": "boolean" },
        "patching": { "enum": ["off", "ask"] },
        "rebuilds": { "enum": ["off", "ask"] },
        "db_prod": { "enum": ["off", "read", "write"] }, "db_sessions": { "enum": ["off", "on"] },
        "overridden": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/definitions/overridable" } }
      }
    },
    "preferences_admin": {
      "description": "GET /api/v1/preferences as routes.md row 219 now specifies it, read by an admin: the keys above plus `viewer`, `bootstrap_admins`, and the admin claim and its value. Nothing answers this yet — it is what the implementing PR has to produce, and it is deliberately a separate object from `preferences` so that widening the contract does not move a sample a server test pins.",
      "allOf": [ { "$ref": "#/properties/preferences" }, { "required": ["viewer", "bootstrap_admins", "groups_claim", "run_by", "access_grace", "delivery"] } ]
    },
    "preferences_member": {
      "description": "The same read answered to a member: one route, one object, minus the admin claim and its value. The schema does not refuse the pair here — the object is the same either way, and which projection a reader gets is a rule about the role, not about the shape — so contracts/validate.py's seam3_guardrails is what refuses a member read that carries it, and names what it is refusing.",
      "allOf": [ { "$ref": "#/properties/preferences" }, { "required": ["viewer", "bootstrap_admins", "groups_claim", "run_by", "access_grace", "delivery"] } ]
    },
    "preferences_put": {
      "type": "object", "additionalProperties": false, "required": ["request", "response"],
      "properties": { "request": { "$ref": "#/definitions/preferencesPut" }, "response": { "$ref": "#/properties/preferences" } }
    },
    "manifest": {
      "type": "object", "additionalProperties": false, "required": ["host", "policies", "component_types", "stacks", "design_system", "prod_approval"],
      "properties": {
        "host": { "type": "string", "maxLength": 2048, "pattern": "^https?://[^@/?#\\s]+$" },
        "policies": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false, "required": ["id", "name", "state"],
            "properties": { "id": { "type": "string", "pattern": "^[a-z]+\\.[a-z][a-z-]*$" }, "name": { "type": "string", "minLength": 1, "maxLength": 80 }, "state": { "enum": ["off", "advisory", "blocking"] }, "production": { "enum": ["off", "advisory", "blocking"] }, "how": { "$ref": "#/definitions/how" }, "instructions": { "$ref": "#/definitions/instructions" }, "says": { "$ref": "#/definitions/says" } },
            "allOf": [ { "if": { "required": ["instructions"] }, "then": { "$ref": "#/definitions/blocksCustom" } }, { "if": { "required": ["how"] }, "then": { "$ref": "#/definitions/blocksCanyon" } }, { "if": { "required": ["says"] }, "then": { "required": ["instructions"] } } ]
          }
        },
        "component_types": { "type": "array", "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" } },
        "stacks": { "$ref": "#/definitions/stacks" },
        "design_system": {
          "type": ["object", "null"], "additionalProperties": false, "required": ["name", "namespace", "registry_url"],
          "properties": { "name": { "$ref": "#/definitions/name" }, "namespace": { "$ref": "#/definitions/namespace" }, "registry_url": { "$ref": "#/definitions/url" }, "tokens_url": { "$ref": "#/definitions/url" } }
        },
        "prod_approval": { "type": "boolean" },
        "app_additions": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["id", "name", "set_by"],
            "anyOf": [ { "required": ["state"] }, { "required": ["production"] } ],
            "allOf": [ { "if": { "required": ["instructions"] }, "then": { "$ref": "#/definitions/blocksCustom" } }, { "if": { "required": ["how"] }, "then": { "$ref": "#/definitions/blocksCanyon" } }, { "if": { "required": ["says"] }, "then": { "required": ["instructions"] } } ],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z]+\\.[a-z][a-z-]*$" }, "name": { "type": "string", "minLength": 1, "maxLength": 80 },
              "state": { "enum": ["off", "advisory", "blocking"] }, "production": { "enum": ["off", "advisory", "blocking"] },
              "how": { "$ref": "#/definitions/how" }, "instructions": { "$ref": "#/definitions/instructions" }, "says": { "$ref": "#/definitions/says" },
              "set_by": {
                "type": "object", "additionalProperties": false, "required": ["kind", "subject", "display"],
                "properties": { "kind": { "enum": ["person", "agent", "canyon"] }, "subject": { "type": "string", "minLength": 1 }, "display": { "type": "string" } }
              }
            }
          }
        }
      }
    },
    "manifest_app": { "$ref": "#/properties/manifest" },
    "design_systems": {
      "type": "object", "additionalProperties": false, "required": ["design_systems"],
      "properties": { "design_systems": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/row" } } }
    },
    "design_system_create": {
      "type": "object", "additionalProperties": false, "required": ["request", "response"],
      "properties": { "request": { "$ref": "#/definitions/designSystemCreate" }, "response": { "type": "object", "additionalProperties": false, "required": ["design_system"], "properties": { "design_system": { "$ref": "#/definitions/row" } } } }
    },
    "setup": { "$ref": "#/definitions/turn" },
    "proposal": { "$ref": "#/definitions/turn" },
    "setup_unavailable": {
      "type": "object", "additionalProperties": false, "required": ["error"],
      "properties": { "error": { "const": "not_found" } }
    },
    "component_types": {
      "type": "object", "additionalProperties": false, "required": ["component_types"],
      "properties": { "component_types": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/componentType" } } }
    }
  }
}
