{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://docs.getcanyon.ai/contracts/schema/timeline-row.schema.json",
  "title": "Canyon timeline row (seam 2)",
  "description": "One persisted row of the run or org timeline, as read by polling. contracts/events.md is canonical: a row's kind comes from its scope's catalogue table, `run` is present exactly when scope = run, and each kind's data has the exact shape the table gives.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "ts", "scope", "project", "kind", "data"],
  "properties": {
    "id": { "type": "integer", "minimum": 1 },
    "ts": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" },
    "scope": { "enum": ["run", "org"] },
    "run": { "$ref": "#/definitions/runId" },
    "project": { "$ref": "#/definitions/project" },
    "kind": {
      "enum": [
        "run.state", "check.started", "check.progress", "check.completed", "producer.sarif", "progress", "scan.waiting", "verdict", "build.image", "build.log", "deploy.completed",
        "app.updated", "tiles.updated", "run.transition", "audit.appended"
      ]
    },
    "data": { "type": "object" }
  },
  "definitions": {
    "answered": {"description": "What the app answered (app-page.schema.json's env.answered, the same shape: validate.py checks the two are one).", "oneOf": [{"type": "object", "additionalProperties": false, "required": ["status", "said"], "properties": {"status": {"type": "integer", "minimum": 100, "maximum": 599}, "said": {"type": "string", "maxLength": 200, "pattern": "^[^\\n]*$"}}}, {"type": "object", "additionalProperties": false, "required": ["error"], "properties": {"error": {"enum": ["no answer in 5 s", "refused", "unreachable", "not an HTTP answer"]}}}]},
    "runId": { "type": "string", "pattern": "^gr_[a-z0-9]{4,}$" },
    "project": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "check": { "type": "string", "minLength": 1 },
    "runState": { "enum": ["pending", "running", "clean", "blocked", "failed"] },
    "sarifLog": { "type": "object", "required": ["version", "runs"] },
    "count": { "type": "integer", "minimum": 0 },
    "actor": { "type": "object", "required": ["kind", "subject", "display"], "additionalProperties": false, "properties": {
      "kind": { "enum": ["person", "agent", "canyon"] }, "subject": { "type": "string", "minLength": 1 }, "display": { "type": "string" } } },
    "approval": { "type": "object", "required": ["rule", "fingerprint", "reason", "expires_at", "approved_by"], "additionalProperties": false, "properties": {
      "rule": { "type": "string", "minLength": 1 }, "fingerprint": { "type": "string", "pattern": "^f_[0-9a-f]{64}$" },
      "reason": { "type": "string", "minLength": 1, "maxLength": 1024 }, "expires_at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" },
      "approved_by": { "allOf": [ { "$ref": "#/definitions/actor" }, { "properties": { "kind": { "const": "person" } } } ] } } }
  },
  "allOf": [
    { "if": { "properties": { "scope": { "const": "run" } } },
      "then": { "required": ["run"], "properties": { "kind": { "enum": ["run.state", "check.started", "check.progress", "check.completed", "producer.sarif", "progress", "scan.waiting", "verdict", "build.image", "build.log", "deploy.completed"] } } } },
    { "if": { "properties": { "scope": { "const": "org" } } },
      "then": { "not": { "required": ["run"] }, "properties": { "kind": { "enum": ["app.updated", "tiles.updated", "run.transition", "audit.appended"] } } } },
    { "if": { "properties": { "kind": { "const": "run.state" } } },
      "then": { "properties": { "data": { "required": ["state"], "additionalProperties": false,
        "allOf": [
          { "if": { "required": ["failed_in"] }, "then": { "required": ["failure_reason"], "properties": { "failure_reason": { "const": "error" } } } },
          { "if": { "required": ["failure_reason"], "properties": { "failure_reason": { "const": "not_platform_only" } } }, "then": { "required": ["not_platform_only"] }, "else": { "not": { "required": ["not_platform_only"] } } },
          { "if": { "required": ["failure_reason"], "properties": { "failure_reason": { "const": "not_same_inputs" } } }, "then": { "required": ["not_same_inputs"] }, "else": { "not": { "required": ["not_same_inputs"] } } } ],
        "properties": {
        "state": { "$ref": "#/definitions/runState" },
        "queue_position": { "type": "integer", "minimum": 0 },
        "failure_reason": { "enum": ["interrupted", "error", "model", "build", "detect", "start", "no_room", "scan_no_room", "image_gone", "not_platform_only", "not_same_inputs", "patch_regressed", "patch_ineffective", "reverted"] },
        "failed_in": { "enum": ["scan", "review", "resources", "build", "deploy"] },
        "not_platform_only": { "enum": ["config_changed", "layers_changed"] },
        "not_same_inputs": { "enum": ["package", "values", "key_rotated", "buildpacks", "dependencies"] } } } } } },
    { "if": { "properties": { "kind": { "const": "check.started" } } },
      "then": { "properties": { "data": { "required": ["check"], "additionalProperties": false, "properties": { "check": { "$ref": "#/definitions/check" } } } } } },
    { "if": { "properties": { "kind": { "const": "check.progress" } } },
      "then": { "properties": { "data": { "required": ["check", "note"], "additionalProperties": false, "properties": { "check": { "$ref": "#/definitions/check" }, "note": { "type": "string", "minLength": 1 } } } } } },
    { "if": { "properties": { "kind": { "const": "check.completed" } } },
      "then": { "properties": { "data": { "required": ["check", "status", "findings", "duration_ms"], "additionalProperties": false, "properties": {
        "check": { "$ref": "#/definitions/check" },
        "status": { "enum": ["clean", "findings", "warning", "skipped", "failed"] },
        "findings": { "type": "integer", "minimum": 0 },
        "duration_ms": { "type": "integer", "minimum": 0 } } } } } },
    { "if": { "properties": { "kind": { "const": "producer.sarif" } } },
      "then": { "properties": { "data": { "oneOf": [
        { "required": ["producer", "sarif"], "additionalProperties": false, "properties": {
          "producer": { "type": "string", "pattern": "^[a-z][a-z0-9/-]*$" },
          "sarif": { "$ref": "#/definitions/sarifLog" } } },
        { "description": "An imported report's row: one per (tool, category) a run includes; a tool with no report has none (events.md).",
          "required": ["producer", "tool", "category", "version", "digest", "attached_by", "dropped", "results"], "additionalProperties": false, "properties": {
          "producer": { "type": "string", "pattern": "^sarif/[a-z0-9]+(-[a-z0-9]+)*$", "maxLength": 46 },
          "tool": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "maxLength": 40 },
          "category": { "type": "string", "pattern": "^([a-z0-9]+(-[a-z0-9]+)*)?$", "maxLength": 128 },
          "version": { "type": "string", "minLength": 1 },
          "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
          "attached_by": { "type": "string", "minLength": 1 },
          "dropped": { "type": "integer", "minimum": 0 },
          "first_dropped": { "type": "string", "pattern": "^result (0|[1-9][0-9]*): .+$" },
          "results": { "type": "array", "maxItems": 1000, "items": { "type": "object", "required": ["ruleId", "level", "message", "locations", "properties"],
            "not": { "required": ["partialFingerprints"] } } } } } ] } } } },
    { "if": { "properties": { "kind": { "const": "progress" } } },
      "then": { "properties": { "data": { "required": ["step", "status"], "additionalProperties": false,
        "allOf": [
          { "if": { "properties": { "step": { "const": "scan" } } }, "then": { "required": ["tool"] }, "else": { "not": { "required": ["tool"] } } },
          { "if": { "required": ["position"] }, "then": { "properties": { "status": { "const": "queued" } } } },
          { "if": { "required": ["duration_ms"] }, "then": { "properties": { "status": { "enum": ["done", "failed"] } } } },
          { "if": { "properties": { "status": { "const": "skipped" } } }, "then": { "required": ["reason"], "properties": { "step": { "const": "scan" } } }, "else": { "not": { "required": ["reason"] } } } ],
        "properties": {
          "step": { "enum": ["scan", "build", "start", "rebase", "image-sbom", "watch"] },
          "tool": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
          "status": { "enum": ["queued", "running", "done", "failed", "skipped"] },
          "reason": { "enum": ["laptop_demo"] },
          "position": { "type": "integer", "minimum": 1 },
          "duration_ms": { "type": "integer", "minimum": 0 } } } } } },
    { "if": { "properties": { "kind": { "const": "scan.waiting" } } },
      "then": { "properties": { "data": { "required": ["tool", "note"], "additionalProperties": false, "properties": {
        "tool": { "enum": ["trivy", "grype"] },
        "note": { "const": "downloading its vulnerability database — the first scan on this host" } } } } } },
    { "if": { "properties": { "kind": { "const": "build.image" } } },
      "then": { "properties": { "data": { "required": ["waited_ms"], "additionalProperties": false, "properties": {
        "waited_ms": { "type": "integer", "minimum": 1 } } } } } },
    { "if": { "properties": { "kind": { "const": "verdict" } } },
      "then": { "properties": { "data": { "required": ["state", "blocking", "warnings", "findings"], "additionalProperties": false, "properties": {
        "state": { "enum": ["clean", "blocked", "failed"] },
        "blocking": { "type": "integer", "minimum": 0 },
        "warnings": { "type": "integer", "minimum": 0 },
        "findings": { "$ref": "#/definitions/sarifLog" },
        "approved": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/approval" } } },
        "if": { "required": ["approved"] }, "then": { "properties": { "state": { "const": "blocked" }, "blocking": { "minimum": 1 } } } } } } },
    { "if": { "properties": { "kind": { "const": "build.log" } } },
      "then": { "properties": { "data": { "required": ["line"], "additionalProperties": false, "properties": { "line": { "type": "string" } } } } } },
    { "if": { "properties": { "kind": { "const": "deploy.completed" } } },
      "then": { "properties": { "data": { "required": ["env", "url", "package", "image_digest"], "additionalProperties": false, "properties": {
        "env": { "enum": ["preview", "prod"] },
        "url": { "type": "string", "pattern": "^https?://" },
        "package": { "type": "string", "pattern": "^pkg_[a-z0-9]{4,}$" },
        "image_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{12,}$" },
        "answered": { "$ref": "#/definitions/answered" } } } } } },
    { "if": { "properties": { "kind": { "const": "app.updated" } } },
      "then": { "properties": { "data": { "required": ["project", "row"], "additionalProperties": false, "properties": { "project": { "$ref": "#/definitions/project" }, "row": { "type": "object" } } } } } },
    { "if": { "properties": { "kind": { "const": "tiles.updated" } } },
      "then": { "properties": { "data": { "required": ["tiles"], "additionalProperties": false, "properties": { "tiles": {
        "type": "object", "required": ["secrets_exposed", "blocked", "approved", "never_reviewed", "unowned", "failed", "refused"], "additionalProperties": false,
        "properties": { "secrets_exposed": { "$ref": "#/definitions/count" }, "blocked": { "$ref": "#/definitions/count" },
          "approved": { "$ref": "#/definitions/count" },
          "never_reviewed": { "$ref": "#/definitions/count" }, "unowned": { "$ref": "#/definitions/count" }, "failed": { "$ref": "#/definitions/count" },
          "refused": { "$ref": "#/definitions/count" } } } } } } } },
    { "if": { "properties": { "kind": { "const": "run.transition" } } },
      "then": { "properties": { "data": { "required": ["project", "run", "state"], "additionalProperties": false, "properties": {
        "project": { "$ref": "#/definitions/project" }, "run": { "$ref": "#/definitions/runId" }, "state": { "$ref": "#/definitions/runState" },
        "kind": { "const": "patch" } } } } } },
    { "if": { "properties": { "kind": { "const": "audit.appended" } } },
      "then": { "properties": { "data": { "required": ["event_id"], "additionalProperties": false, "properties": { "event_id": { "type": "string", "minLength": 1 } } } } } }
  ]
}
