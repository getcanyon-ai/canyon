# The build executor: the one container that holds the Docker socket. It carries the docker
# and pack CLIs (pinned) and the canyon-executor binary, and nothing else — no vault, no org
# config, no database (contracts/executor.md).
FROM golang:1.26.11@sha256:4165ee6bf3b7811fd7b40373290405c83d0167dcb87ee5f29c427cdcef45ff8f AS build
WORKDIR /src
COPY go.mod go.sum* ./
# Go's default; CI passes a list that asks the proxy again on any error (#2533)
ARG GOPROXY=https://proxy.golang.org,direct
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -trimpath -ldflags "-s -w" -o /out/canyon-executor ./cmd/canyon-executor

FROM docker:28.4.0-cli@sha256:6a73c9433f2ba4279815be1e60f5739288b939dda1e48151d8c393537802de37 AS pack
ARG TARGETARCH
# The version and sha256 values are the Makefile's (PACK_VERSION, PACK_SHA256_*): compose passes
# them as build args so they live in one place. PACK_URL is the Makefile's too, its release's
# directory: a test points it at a stub (#2755).
ARG PACK_VERSION
ARG PACK_SHA256_AMD64
ARG PACK_SHA256_ARM64
ARG PACK_URL=https://github.com/buildpacks/pack/releases/download/v${PACK_VERSION}
# A failed download, a GitHub 504 among them, is tried again after 1, 2, 4, 8, 16 and 32 s (#2755);
# whatever arrives must still match the pinned sha256.
RUN set -eu; case "$TARGETARCH" in \
      amd64) f="pack-v${PACK_VERSION}-linux.tgz"; sum="$PACK_SHA256_AMD64" ;; \
      arm64) f="pack-v${PACK_VERSION}-linux-arm64.tgz"; sum="$PACK_SHA256_ARM64" ;; \
      *) echo "unsupported arch $TARGETARCH" >&2; exit 1 ;; esac; \
    for wait in 1 2 4 8 16 32 end; do \
      rm -f /tmp/pack.tgz; wget -qO /tmp/pack.tgz "${PACK_URL}/${f}" && break; \
      if [ "$wait" = end ]; then echo "pack: ${PACK_URL}/${f} failed 7 times" >&2; exit 1; fi; \
      echo "pack: ${PACK_URL}/${f} failed; trying again in ${wait} s" >&2; sleep "$wait"; done; \
    echo "${sum}  /tmp/pack.tgz" | sha256sum -c -; \
    tar -xzf /tmp/pack.tgz -C /usr/local/bin pack; rm /tmp/pack.tgz

FROM docker:28.4.0-cli@sha256:6a73c9433f2ba4279815be1e60f5739288b939dda1e48151d8c393537802de37
COPY --from=pack /usr/local/bin/pack /usr/local/bin/pack
COPY --from=build /out/canyon-executor /canyon-executor
# Canyon's licence, NOTICE, and the licence texts of the third-party code in the binary (THIRD_PARTY_NOTICES).
COPY LICENSE NOTICE THIRD_PARTY_NOTICES /usr/share/doc/canyon/
EXPOSE 7778
ENTRYPOINT ["/canyon-executor"]
