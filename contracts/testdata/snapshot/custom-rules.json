        "by": "ai",
        "facts_version": 3
      },
      "playbook": {
        "slug": "service-conventions",
        "name": "How Meridian writes a service"
      }
    },
    {
      "id": "custom.no-console-pii",
      "name": "No personal data in logs",
      "state": "off",
      "producer": "llm-review",
